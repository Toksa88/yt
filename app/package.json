{
  "name": "music-grabber",
  "version": "1.0.1",
  "description": "Пошук, прослуховування й завантаження музики з YouTube Music, YouTube та SoundCloud",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "bins": "node scripts/fetch-bins.js",
    "icon": "node scripts/make-icon.js",
    "prebuild": "node scripts/fetch-bins.js",
    "prerelease": "node scripts/fetch-bins.js",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "test": "npm run test:fast && npm run test:live",
    "test:fast": "node test/store.test.js && node test/parse.test.js && node test/args.test.js",
    "test:live": "node test/download.test.js && node test/ui.test.js",
    "test:store": "node test/store.test.js",
    "test:parse": "node test/parse.test.js",
    "test:args": "node test/args.test.js",
    "test:download": "node test/download.test.js",
    "test:ui": "node test/ui.test.js"
  },
  "author": "Toksa88",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Toksa88/yt.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.14.0",
    "ytmusic-api": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.toksa88.musicgrabber",
    "productName": "Music Grabber",
    "copyright": "Copyright (c) 2026 Toksa88",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Grabber",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}