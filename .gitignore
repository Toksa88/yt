# --- Завантажена музика та обкладинки (медіа в git не тримають) ---
*.mp3
*.m4a
*.opus
*.webm
*.webp
*.jpg
*.jpeg
*.png
*.part
*.ytdl

# ...але знімки екрана для README потрібні саме в репозиторії
!docs/**/*.png
!docs/**/*.jpg

# --- Артефакти збірки PyInstaller ---
build/
dist/
*.spec

# --- Node / Electron ---
node_modules/
# сюди кладуться вшиті yt-dlp.exe та ffmpeg.exe — це чужі бінарники, не наш код
app/bin/

# --- Особисті налаштування (свої шляхи в кожного) ---
settings.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
